# --- Docker volumes (local data) ---
infra/data/
infra/data/**
postgres-data/
minio-data/

# --- JWT RSA-ключи (секреты; генерируются `make gen-jwt-keys`, §16 п.15) ---
infra/jwt-keys/

# --- TLS-сертификаты (секреты; `make gen-self-signed-certs` или Let's Encrypt, §16 п.24) ---
infra/nginx/certs/

# --- Бэкапы БД (make backup; §16 п.24) ---
infra/backups/

# --- Alembic local ---
apps/api/alembic/versions/__pycache__/

# --- Generated files (runtime) ---
*.local

# --- Celery beat runtime state (shelve-файл пишет контейнер beat) ---
apps/api/celerybeat-schedule
test-results/

