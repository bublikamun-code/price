# ============================================================
#  B2B «Клиентский портал» — пример переменных окружения
#  Скопируйте в `.env` и заполните реальные значения.
# ============================================================

# --- Окружение ---
ENV=dev                       # dev | staging | prod
APP_NAME=price-portal
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-to-a-long-random-string   # подпись JWT при HS256
JWT_ALGORITHM=HS256           # dev — HS256; prod — RS256 (§16 п.15)
# Для RS256: сгенерируйте пару `make gen-jwt-keys` (→ infra/jwt-keys/) и укажите
# пути к PEM-файлам. В prod они монтируются read-only (см. infra/docker-compose.prod.yml):
# JWT_PRIVATE_KEY_PATH=/jwt-keys/jwt_rsa.key
# JWT_PUBLIC_KEY_PATH=/jwt-keys/jwt_rsa.pub
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Frontend ---
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8080

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=price
POSTGRES_PASSWORD=price_secret
POSTGRES_DB=price_portal

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO / S3 ---
S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_PHOTOS=photos-series
S3_BUCKET_PDFS=pdf-catalogs
S3_BUCKET_EXPORTS=csv-exports
S3_BUCKET_TMP=tmp-uploads
S3_BUCKET_ERRORS=error-logs

# --- НБ РБ (курсы валют) ---
NBRB_RATES_URL=https://www.nbrb.by/api/exrates/rates
NBRB_FETCH_CRON="5 0 * * *"          # ежедневно 00:05 (Europe/Minsk)
BASE_CURRENCY=BYN
DISPLAY_CURRENCIES=BYN,USD,EUR,RUB

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=            # chat_id менеджера для уведомлений
TELEGRAM_WEBHOOK_URL=

# --- 1C integration (заглушки, MVP не реализован) ---
INTEGRATION_1C_TOKEN=
INTEGRATION_1C_IP_ALLOWLIST=

# --- Security ---
RATE_LIMIT_LOGIN=5/15minutes
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# COOKIE_SECURE=true   # prod: только HTTPS-куки (§16 п.30)

# --- Observability (§12, §16 п.23) ---
# Пусто = push Celery-метрик выключен (fail-open).
# Ставится автоматически overlay'ом infra/docker-compose.observability.yml (make obs-up):
PUSHGATEWAY_URL=

# Креды админа Grafana (make obs-up); дефолт admin/admin — только для dev,
# в prod обязательно переопределить здесь (§16 п.28):
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- PROD (Этап 11, §14/§16 п.24; деплой — docs/RUNBOOK.md) ---
DOMAIN=localhost                 # домен в зоне .by при боевом деплое (§19)
# TLS-сертификаты кладутся в infra/nginx/certs/{fullchain,privkey}.pem
# (монтируются nginx'ом по путям compose — здесь только путь для certbot/RUNBOOK):
#   тест: make gen-self-signed-certs
#   боевые: Let's Encrypt (certbot --nginx или DNS-challenge) — см. docs/RUNBOOK.md
# Бэкапы: make backup (retention задаётся в infra/scripts/backup_db.sh, 30 д.)

# Host-порты dev-стека (переопределять при конфликте портов с другими проектами)
# DEV_DB_PORT=5433
# DEV_REDIS_PORT=6380
# DEV_NGINX_PORT=8081
